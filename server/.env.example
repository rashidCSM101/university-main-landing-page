PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=wenclims_db
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# JWT Secrets — generate strong values with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_jwt_access_secret_here
JWT_REFRESH_SECRET=your_strong_random_jwt_refresh_secret_here
COOKIE_SECRET=your_strong_random_cookie_secret_here

# CORS — allowed origins for production
# CLIENT_URL = your public site URL (e.g. https://hex-byte.tech)
# ADMIN_URL  = your admin panel URL (e.g. https://admin.hex-byte.tech or same domain)
CLIENT_URL=https://hex-byte.tech
ADMIN_URL=https://admin.hex-byte.tech

# Morgan request logging format: 'dev' | 'combined' | 'short'
# Leave blank to use default (dev in development, combined in production)
MORGAN_FORMAT=dev
